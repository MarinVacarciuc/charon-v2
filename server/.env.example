# Copy to server/.env and fill in. .env is gitignored and excluded from the
# OneDrive mirror.

# Shared secret for every mutating endpoint. The admin UI asks for it once and
# keeps it in localStorage; read-only routes (SSE, frames, the gate terminal) stay
# open on the LAN so a phone at the gate needs no login.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CHARON_ADMIN_TOKEN=

# Telegram bot used for tokens and personal alerts. Leave blank to disable.
CHARON_TG_TOKEN=

# Bind address. 0.0.0.0 so the gate terminal phone and the dashboard can reach it.
CHARON_HOST=0.0.0.0
CHARON_PORT=8770

# Recognition tuning. Live values live in the config_kv table and are editable from
# Settings; these are only the first-run seeds.
CHARON_SIM_THRESHOLD=0.45
CHARON_CONFIRM_FRAMES=3
CHARON_DWELL_MS=2000
